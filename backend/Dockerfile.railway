# =============================================================================
# King Jam AI - Railway 部署 Dockerfile
# 精簡版：移除中文字體等大型套件以加快 Railway 建構速度
# =============================================================================

FROM python:3.10-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 只安裝必要的系統套件（不含 fonts-noto-cjk，大幅減少 build 時間）
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 安裝 Python 依賴
# 使用通配符以支援不同的 Build Context（根目錄或 backend 子目錄）
COPY requirements.txt* backend/requirements.txt* ./
RUN pip install --no-cache-dir -r requirements.txt

# 複製應用程式代碼
COPY . .

# 建立非 root 用戶
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# 建立必要目錄
RUN mkdir -p /app/static/uploads /app/static/videos /app/static/thumbnails

# 暴露端口（Railway 會讀取 EXPOSE 指定 port）
EXPOSE 8080

# 同時支援 repo 根目錄與 backend 子目錄兩種 build context（見 backend/Dockerfile 註解）
CMD ["/bin/sh", "-c", "if [ -f /app/backend/start.py ]; then cd /app/backend && exec python start.py; else exec python start.py; fi"]
