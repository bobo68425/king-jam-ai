            "mimeType": "application/json",
            "text": "{\"items\":[{\"id\":786,\"user_id\":1,\"generation_type\":\"short_video\",\"status\":\"completed\",\"input_params\":{\"project_id\":\"v3_clips\",\"title\":\"場景片段: With King Jam A...\",\"prompt\":\"A dynamic showcase of various edited content pieces coming together, with King Jam AI at the forefront guiding the process, cinematic lighting, high detail, 8k resolution.\",\"model\":\"Kling/Wan (v3)\",\"aspect_ratio\":\"9:16\",\"duration\":\"5\"},\"output_caption\":\"With King Jam AI by your side, transforming your ideas into stunning visuals has never been easier!\",\"media_local_path\":null,\"media_cloud_url\":\"https://pub-ce2c051c6f0d48809b2b95a4ef62fbdc.r2.dev/videos/1/2026/03/46dfb9ab_072037.mp4\",\"media_cloud_key\":null,\"thumbnail_url\":null,\"credits_used\":5,\"error_message\":null,\"generation_duration_ms\":null,\"file_size_bytes\":null,\"created_at\":\"2026-03-09T07:21:14.390180Z\",\"group_key\":\"video_v3_clips\"},{\"id\":785,\"user_id\":1,\"generation_type\":\"short_video\",\"status\":\"completed\",\"input_params\":{\"project_id\":\"v3_clips\",\"title\":\"場景片段: King Jam AI ana...\",\"prompt\":\"The AI interface displays a split-screen showing a video editing timeline on one side and King Jam AI actively pointing out areas for improvement, cinematic lighting, high detail, 8k resolution.\",\"model\":\"Kling/Wan (v3)\",\"aspect_ratio\":\"9:16\",\"duration\":\"5\"},\"output_caption\":\"King Jam AI analyzes your content in real-time, providing suggestions and improvements instantly.\",\"media_local_path\":null,\"media_cloud_url\":\"https://pub-ce2c051c6f0d48809b2b95a4ef62fbdc.r2.dev/videos/1/2026/03/0f513f8f_072108.mp4\",\"media_cloud_key\":null,\"thumbnail_url\":null,\"credits_used\":5,\"error_message\":null,\"generation_duration_ms\":null,\"file_size_bytes\":null,\"created_at\":\"2026-03-09T07:21:14.080252Z\",\"group_key\":\"video_v3_clips\"},{\"id\":784,\"user_id\":1,\"generation_type\":\"short_video\",\"status\":\"completed\",\"input_params\":{\"project_id\":\"v3_clips\",\"title\":\"場景片段: Introducing Kin...\",\"prompt\":\"A sleek AI interface with vibrant colors and smooth animations, featuring a digital assistant resembling a friendly humanoid figure, cinematic lighting, high detail, 8k resolution.\",\"model\":\"Kling/Wan (v3)\",\"aspect_ratio\":\"9:16\",\"duration\":\"5\"},\"output_caption\":\"Introducing King Jam AI, your personal super editor! Watch as it comes to life, ready to assist with your creative needs.\",\"media_local_path\":null,\"media_cloud_url\":\"https://pub-ce2c051c6f0d48809b2b95a4ef62fbdc.r2.dev/videos/1/2026/03/5f105c77_072042.mp4\",\"media_cloud_key\":null,\"thumbnail_url\":null,\"credits_used\":5,\"error_message\":null,\"generation_duration_ms\":null,\"file_size_bytes\":null,\"created_at\":\"2026-03-09T07:21:13.757508Z\",\"group_key\":\"video_v3_clips\"},{\"id\":776,\"user_id\":1,\"generation_type\":\"short_video\",\"status\":\"completed\",\"input_params\":{\"project_id\":\"v3_clips\",\"title\":\"場景片段: 讓 King Jam AI 成...\",\"prompt\":\"A wide shot of a creative team collaborating, with the King Jam AI interface being projected on a large screen in the background, emphasizing teamwork and innovation. Cinematic lighting, high detail, stable motion, 8k resolution.\",\"model\":\"Kling/Wan (v3)\",\"aspect_ratio\":\"9:16\",\"duration\":\"5\"},\"output_caption\":\"讓 King Jam AI 成為你的專屬小編，提升你的創作效率！\",\"media_local_path\":null,\"media_cloud_url\":\"https://pub-ce2c051c6f0d48809b2b95a4ef62fbdc.r2.dev/videos/1/2026/03/da1c2338_062955.mp4\",\"media_cloud_key\":null,\"thumbnail_url\":null,\"credits_used\":5,\"error_message\":null,\"generation_duration_ms\":null,\"file_size_bytes\":null,\"created_at\":\"2026-03-09T06:30:34.796778Z\",\"group_key\":\"video_v3_clips\"},{\"id\":775,\"user_id\":1,\"generation_type\":\"short_video\",\"status\":\"completed\",\"input_params\":{\"project_id\":\"v3_clips\",\"title\":\"場景片段: 不論是文字創作還是內容編輯，K...\",\"prompt\":\"A close-up of hands typing on a sleek keyboard, with the King Jam AI pop-up suggestions appearing dynamically on the screen. Cinematic lighting, high detail, stable motion, 8k resolution.\",\"model\":\"Kling/Wan (v3)\",\"aspect_ratio\":\"9:16\",\"duration\":\"5\"},\"output_caption\":\"不論是文字創作還是內容編輯，King Jam AI 都能提供即時的建議。\",\"media_local_path\":null,\"media_cloud_url\":\"https://pub-ce2c051c6f0d48809b2b95a4ef62fbdc.r2.dev/videos/1/2026/03/5de2d9c6_063028.mp4\",\"media_cloud_key\":null,\"thumbnail_url\":null,\"credits_used\":5,\"error_message\":null,\"generation_duration_ms\":null,\"file_size_bytes\":null,\"created_at\":\"2026-03-09T06:30:34.459487Z\",\"group_key\":\"video_v3_clips\"},{\"id\":774,\"user_id\":1,\"generation_type\":\"short_video\",\"status\":\"completed\",\"input_params\":{\"project_id\":\"v3_clips\",\"title\":\"場景片段: 在這數位時代，King Jam...\",\"prompt\":\"A sleek, modern workspace featuring the King Jam AI interface on a high-resolution screen, showcasing a vibrant digital environment with captivating graphics and colors. Cinematic lighting, high detail, stable motion, 8k resolution.\",\"model\":\"Kling/Wan (v3)\",\"aspect_ratio\":\"9:16\",\"duration\":\"5\"},\"output_caption\":\"在這數位時代，King Jam AI 讓創作變得更簡單。\",\"media_local_path\":null,\"media_cloud_url\":\"https://pub-ce2c051c6f0d48809b2b95a4ef62fbdc.r2.dev/videos/1/2026/03/632e630e_062930.mp4\",\"media_cloud_key\":null,\"thumbnail_url\":null,\"credits_used\":5,\"error_message\":null,\"generation_duration_ms\":null,\"file_size_bytes\":null,\"created_at\":\"2026-03-09T06:30:34.129743Z\",\"group_key\":\"video_v3_clips\"},{\"id\":768,\"user_id\":1,\"generation_type\":\"short_video\",\"status\":\"completed\",\"input_params\":{\"project_id\":\"v3_clips\",\"title\":\"場景片段: 不再孤單工作，讓 King J...\",\"prompt\":\"展示團隊合作的畫面，幾位同事在一起使用 King Jam AI 進行討論和協作，畫面溫暖明亮，展現活力與創意，搭配 cinematic lighting 和 high detail。\",\"model\":\"Kling/Wan (v3)\",\"aspect_ratio\":\"9:16\",\"duration\":\"5\"},\"output_caption\":\"不再孤單工作，讓 King Jam AI 成為您最可靠的夥伴。\",\"media_local_path\":null,\"