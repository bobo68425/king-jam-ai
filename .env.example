# ============================================================
# King Jam AI - 環境變數範本
# ============================================================
# 複製此檔案為 .env 並填入實際值
# cp .env.example .env
# ⚠️ 請勿將 .env 提交到 Git
# ============================================================

# --- JWT 認證 ---
SECRET_KEY=your-super-secret-key-change-this-in-production

# --- Google AI / OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_GEMINI_KEY=your_google_gemini_key

# --- Replicate API (Kling AI) ---
REPLICATE_API_TOKEN=your_replicate_api_token

# --- 告警通知（可選）---
SLACK_WEBHOOK_URL=
ALERT_EMAIL=
LINE_NOTIFY_TOKEN=

# --- Vertex AI / Veo ---
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# --- 雲端儲存 (Cloudflare R2) ---
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kingjam-assets
R2_PUBLIC_URL=https://your_r2_public_url.r2.dev

# --- 社群平台 OAuth（需要時填入）---
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business Configuration ID（IG 使用 Facebook Login 時需此欄位）
META_CONFIG_ID=
# Meta Webhook 驗證權杖（與後台「驗證權杖」欄位相同，用於 Webhook 驗證）
META_WEBHOOK_VERIFY_TOKEN=kingjam_meta_verify

# Instagram API with Instagram Login 專用（不需粉專，用戶用 IG 帳號登入）
# 若設定則優先使用，不需 META_CONFIG_ID。於 Meta 後台 Instagram → API setup with Instagram login → Business login settings 取得
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Threads 專用憑證（Threads API 需使用 Threads use case 的 App ID/Secret，與 FB/IG 不同）
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- 郵件服務 (SMTP) ---
SMTP_USER=service@kingjam.app
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=service@kingjam.app
